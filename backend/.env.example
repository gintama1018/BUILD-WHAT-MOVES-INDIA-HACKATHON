# RTI Assistant — Backend Environment
# Copy this file to .env and fill in values

# Anthropic API — REQUIRED for AI-powered intent extraction + explanations
# If not set, the system falls back to keyword matching (still functional)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Model name — defaults to claude-sonnet-5 (verified current 2026-08-26)
# DO NOT hardcode model names in application code — always use this env var
AI_MODEL_NAME=claude-sonnet-5

# Server
PORT=3001
FRONTEND_URL=http://localhost:5173

# Database — default: backend/data/rti.db (auto-created on first run)
# DATABASE_URL=/custom/path/to/rti.db

# AI timeout in ms (default 12000)
# AI_TIMEOUT_MS=12000
