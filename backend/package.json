{
  "name": "rti-assistant-backend",
  "version": "1.0.0",
  "description": "RTI Jurisdiction & Authority Discovery Assistant — Backend",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon --exec npx tsx src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "seed": "npx tsx src/db/seed/run_seed.ts",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:watch": "vitest"
  },
  "keywords": [
    "rti",
    "india",
    "jurisdiction",
    "hackathon"
  ],
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.3.0",
    "@types/uuid": "^10.0.0",
    "nodemon": "^3.1.14",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "uuid": "^14.0.2"
  }
}
